{
  "name": "birdie-report",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run validate:editorial-trust && python3 scripts/validate-images.py --local-only-on-vercel",
    "validate:editorial-trust": "node scripts/validate-editorial-trust.mjs",
    "build": "astro build --force",
    "check:images": "python3 scripts/validate-images.py",
    "preview": "astro preview",
    "astro": "astro",
    "test:seo": "node --test scripts/analytics.test.mjs scripts/editorial.test.mjs scripts/discovery.test.mjs && python3 scripts/test_seo.py"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.18.1",
    "tailwindcss": "^3.4.19"
  }
}
