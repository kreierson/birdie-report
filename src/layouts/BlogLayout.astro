                      data-guide-defer={buyerGuide && thumbFor(post.data.featured_image) ? '' : undefined}
                      alt={post.data.title}
                      width={(buyerGuide ? thumbFor(post.data.featured_image)?.width : localImageSize(post.data.featured_image)?.width) || undefined}
                      height={(buyerGuide ? thumbFor(post.data.featured_image)?.height : localImageSize(post.data.featured_image)?.height) || undefined}
