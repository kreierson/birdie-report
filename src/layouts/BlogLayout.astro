</BaseLayout>

<script define:vars={{ activeAmazonTag }}>
document.addEventListener('DOMContentLoaded', function() {
  // Reading time
  const article = document.querySelector('article .prose');
  if (article) {
    const text = article.textContent || '';
    const words = text.trim().split(/\s+/).length;
    const readingTime = Math.ceil(words / 200);
    const el = document.getElementById('reading-time');
    if (el) el.textContent = `${readingTime} min read`;
  }

  // Table of contents
  const toc = document.getElementById('toc');
  const headings = document.querySelectorAll('article .prose h2, article .prose h3');
  const guideHeadings = document.querySelectorAll('[data-guide-toc]');
  if (toc && !toc.querySelector('a')) {
    if (headings.length > 0 || guideHeadings.length > 0) {
      toc.innerHTML = '';
      guideHeadings.forEach((heading) => {
        if (!heading.id) return;
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent || '';
        link.className = 'flex min-h-6 items-center font-medium text-gray-600 hover:text-forest-700 transition-colors leading-snug';
        toc.appendChild(link);
      });
      headings.forEach((heading, i) => {
        const id = heading.id || `heading-${i}`;
        heading.id = id;
        const link = document.createElement('a');
        link.href = `#${id}`;
        link.textContent = heading.textContent || '';
        link.className = `flex min-h-6 items-center text-gray-600 hover:text-forest-700 transition-colors leading-snug ${heading.tagName === 'H3' ? 'pl-3 text-xs' : 'font-medium'}`;
        toc.appendChild(link);
      });
    } else {
      toc.innerHTML = '<p class="text-gray-500 text-xs italic">No sections</p>';
    }
  }

  if (article) {
    // External links
    article.querySelectorAll('a[href]').forEach((link) => {
      if (link.hostname !== window.location.hostname) {
        if ((link.hostname === 'amazon.com' || link.hostname.endsWith('.amazon.com'))) {
          const affiliateUrl = new URL(link.href);
          affiliateUrl.searchParams.set('tag', activeAmazonTag);
          link.href = affiliateUrl.toString();
          link.dataset.affiliateLink = 'true';
          link.dataset.retailer = link.dataset.retailer || 'Amazon';
          link.dataset.placement = link.dataset.placement || 'article-body-link';
        }

        link.setAttribute('target', '_blank');
        link.setAttribute('rel', link.dataset.affiliateLink === 'true' ? 'nofollow sponsored noopener' : 'noopener');
      }
    });
  }


});
</script>

