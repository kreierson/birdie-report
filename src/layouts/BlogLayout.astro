---
import BaseLayout from './BaseLayout.astro';
import GearGuideLinks from '../components/GearGuideLinks.astro';
import GuideScorecard from '../components/GuideScorecard.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import { getCollection } from 'astro:content';
import { selectRelatedPosts } from '../utils/discovery.mjs';
import QuickPicks from '../components/QuickPicks.astro';
import GuideByline from '../components/GuideByline.astro';
import GuideCompare from '../components/GuideCompare.astro';
import GuideStickyNav from '../components/GuideStickyNav.astro';
import GuideTopPicks from '../components/GuideTopPicks.astro';
import ProductBuyBox from '../components/ProductBuyBox.astro';
import { getAmazonTag, isDirectAmazonProductUrl, normalizeAffiliateLinks, normalizeAffiliateUrl } from '../utils/affiliate';
import { buyerProductsFromContent } from '../utils/buyer-links.mjs';
import { bestForLine, imageForBuyer, isAmazonCommerce, isSourcedNonAmazonPrice, productNamesMatch } from '../utils/product-buy.mjs';
import { selectRelatedGuides } from '../utils/related-guides.mjs';
import { resolveQuickPicks } from '../utils/quick-picks.mjs';
import { buildGuideModel, formatGuideDate, isBuyerGuide as buyerGuidePage, markdownHeadings, researchDisclosure } from '../utils/guide-template.mjs';
import { buildStructuredData, jsonLd, stockImageUrls, visibleScorecard } from '../utils/review-schema.mjs';
import { deliveredSocial, deliveredSrc, guideDelivery, rewriteMarkdownImages, thumbFor } from '../utils/guide-images.mjs';
import { localImageSize } from '../utils/image-size.mjs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { postTrail } from '../utils/breadcrumbs.mjs';

export interface Props {
  content: any;
  body?: string;
}

const { content, body = '' } = Astro.props;
const site = 'https://www.birdiereport.com';
const { title, description, date, updated, category, tags, author, review_basis, featured_image, affiliate_links, bounty_links, comparison_products, rating, pros, cons, price, subcategory, seo_title, seo_description, affiliate_tracking_id } = content;
const reviewHeroSize = localImageSize(featured_image);
const pageTitle = seo_title || title;
const pageDescription = seo_description || description;
const affiliateContext = { category, subcategory, trackingId: affiliate_tracking_id };
const activeAmazonTag = getAmazonTag(affiliateContext);
const resolvedBuyerProducts = normalizeAffiliateLinks(buyerProductsFromContent(content), affiliateContext);
const resolvedBountyLinks = normalizeAffiliateLinks(bounty_links || [], affiliateContext);
const heroBuyLinks = resolvedBuyerProducts.slice(0, 3);
// News covers retail launches. The same modules run once a post has product links.
const hasBuyerIntent = ['best', 'reviews', 'deals', 'versus', 'news'].includes(category) && heroBuyLinks.length > 0;
const quickPicks = resolveQuickPicks(content.quick_picks, affiliateContext, {
  normalizeAffiliateUrl,
  isDirectAmazonProductUrl,
});
const stickyCta = quickPicks[0] || heroBuyLinks[0];
function cardRetailer(link: { url?: string; retailer?: string } | undefined) {
  const stored = link?.retailer || 'Amazon';
  try {
    const host = new URL(link?.url || '').hostname.replace(/^www\./, '');
    if (host === 'amazon.com' || host.endsWith('.amazon.com')) return 'Amazon';
  } catch {
    return stored;
  }
  return stored;
}
const stickyRetailer = cardRetailer(stickyCta);

const allPosts = await getCollection('blog');
const currentSlug = Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');
const relatedPosts = selectRelatedPosts(allPosts, { slug: currentSlug, data: content });
const relatedGuides = selectRelatedGuides({ slug: currentSlug, title, description, category, subcategory, tags });

const isReview = category === 'reviews' || (rating && pros);
const displayAuthor = author;

const reviewBasis = researchDisclosure(review_basis);
const buyerGuide = buyerGuidePage(content);
const guideModel = buyerGuide ? buildGuideModel({ picks: quickPicks, body, subcategory }) : null;
const guideDate = updated || date;
const guideDateLabel = updated ? 'Updated' : 'Published';

const categoryLabels: Record<string, string> = {
  best: 'Best Of',
  reviews: 'Reviews',
  tips: 'Tips',
  news: 'News',
  deals: 'Deals',
  courses: 'Courses',
  versus: 'Versus',
  opinion: 'Opinion',
};

const categoryColors: Record<string, string> = {
  best: 'bg-gold-500 text-forest-900',
  reviews: 'bg-forest-700 text-white',
  tips: 'bg-blue-600 text-white',
  news: 'bg-red-600 text-white',
  deals: 'bg-orange-700 text-white',
  courses: 'bg-emerald-800 text-white',
  versus: 'bg-purple-600 text-white',
  opinion: 'bg-rose-600 text-white',
};

const stockImages = stockImageUrls(allPosts.map((post) => post.data.featured_image));
const guidePhoto = buyerGuide ? guideDelivery(featured_image) : null;
if (buyerGuide && featured_image && !guidePhoto) {
  throw new Error(`Buyer guide is missing an optimized photo for ${featured_image}`);
}
const schemaImage = deliveredSrc(featured_image) || featured_image;
const schemaInput = {
  site,
  pathname: Astro.url.pathname,
  title,
  description,
  date,
  updated,
  author: displayAuthor,
  featuredImage: schemaImage,
  body: rewriteMarkdownImages(body),
  stockImages,
  category,
  rating,
  pros,
  cons,
  price,
  comparisonProducts: comparison_products,
  affiliateLinks: affiliate_links,
};
const schemaMarkup = buildStructuredData(schemaInput);
const guideScores = visibleScorecard(schemaInput);
const breadcrumbs = postTrail(category, title, Astro.url.pathname);
const buyerNames = resolvedBuyerProducts.map((link) => link.product);
const buyerCards = resolvedBuyerProducts.map((link) => ({
  ...link,
  image: imageForBuyer(link.product, schemaInput, buyerNames, link.image || ''),
}));
const heroCards = buyerCards.slice(0, 3);
const leadProduct = !buyerGuide && hasBuyerIntent && quickPicks.length === 0 ? heroCards[0] : null;
const leadRetailer = leadProduct?.retailer || 'Amazon';
const leadAmazon = /^amazon(?:\.com)?$/i.test(leadRetailer);
const leadCta = leadAmazon ? 'Check Amazon' : `Check ${leadRetailer}`;
const leadBestFor = leadProduct ? bestForLine({ ...leadProduct, pros: leadProduct.pros?.length ? leadProduct.pros : pros }).replace(/\$\s*\d[\d,.]*/g, '').trim() : '';
const amazonOnlyBuys = buyerCards.length > 0 && buyerCards.every((link) => isAmazonCommerce(link.retailer, link.url));
const verdictPrice = amazonOnlyBuys && price && /\$\s*\d/.test(price) && !isSourcedNonAmazonPrice(price) ? '' : (price || '');
const tocItems = [];
if (buyerGuide && guideModel?.hasPicks) {
  tocItems.push({ id: 'our-top-picks', depth: 2, text: guideModel.heading });
  tocItems.push({ id: 'compare-heading', depth: 2, text: 'Compare at a glance' });
}
for (const heading of markdownHeadings(body)) {
  if (heading.depth === 2 || heading.depth === 3) tocItems.push(heading);
}
const quickPickNames = quickPicks.map((pick) => pick.product);
const quickPickCards = quickPicks.map((pick) => {
  const match = buyerCards.find((link) => productNamesMatch(pick.product, link.product));
  return {
    ...pick,
    price: pick.price || match?.price || '',
    image: imageForBuyer(pick.product, schemaInput, [...quickPickNames, ...buyerNames], pick.image || ''),
  };
});
---

<BaseLayout title={pageTitle} description={pageDescription} image={deliveredSocial(featured_image) || schemaImage} guideTemplate={buyerGuide}>
  <script type="application/ld+json" set:html={jsonLd(schemaMarkup)} />

  <Breadcrumbs items={breadcrumbs} />

  <div class:list={['max-w-7xl mx-auto px-4 sm:px-6 lg:px-8', buyerGuide ? 'py-4 lg:py-12' : 'py-3 lg:py-12']}>
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-10">
      <!-- Main Article -->
      <article class:list={['min-w-0', buyerGuide && 'guide-template']} data-guide-template={buyerGuide ? 'buyer' : undefined}>
        <!-- Header -->
        {buyerGuide ? (
          <header class="mb-2">
            <h1 class="font-display text-[26px] font-bold leading-[32px] text-forest-900 [text-wrap:balance] sm:text-4xl lg:text-5xl lg:leading-tight">
              {title}
            </h1>
            <GuideByline
              author={displayAuthor}
              dateLabel={guideDateLabel}
              dateText={formatGuideDate(guideDate)}
              dateISO={guideDate.toISOString()}
              disclosure={reviewBasis}
            />
          </header>
        ) : (
        <header class="mb-3">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class={`inline-flex h-7 items-center rounded-sm px-2.5 text-[11px] font-bold uppercase tracking-wider ${categoryColors[category] || 'bg-gray-600 text-white'}`}>
              {categoryLabels[category] || category}
            </span>
            {subcategory && (
              <span class="inline-flex h-7 items-center rounded-sm bg-gray-200 px-2.5 text-[11px] font-bold uppercase tracking-wide text-gray-600">{subcategory.replace('-', ' ')}</span>
            )}
          </div>

          <h1 class="font-display text-[26px] font-bold leading-[31px] tracking-tight text-forest-900 [text-wrap:balance] lg:text-[40px] lg:leading-[48px]">
            {title}
          </h1>

          <p class="mt-2 text-[15px] leading-[21px] text-gray-700 lg:text-lg lg:leading-7">
            {description}
          </p>

          <div class="mt-2 flex min-h-11 flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-600">
            <img src="/images/kyle-reierson.jpg" alt="" width="32" height="32" class="h-8 w-8 rounded-full object-cover" />
            <a href="/about/" class="inline-flex min-h-11 items-center font-semibold text-forest-900 underline underline-offset-2">{displayAuthor}</a>
            <time datetime={date.toISOString()}>
              {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </time>
            {updated && (
              <span>
                Updated <time datetime={updated.toISOString()}>{updated.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</time>
              </span>
            )}
          </div>
          <div class="flex items-center gap-3 text-sm text-gray-600">
            <span id="reading-time">5 min read</span>
            {rating && <span class="font-semibold text-[#7A5C1D]">★ {rating}/10</span>}
          </div>

          {reviewBasis && review_basis === 'research-based' && (
            <p class="research-line mt-2 bg-[#F3F6F2] font-body text-[13px] leading-[18px] text-[#12301C]">
              <span>Research-based review, not a hands-on test.</span>
              <a href="/affiliate-disclosure/" class="font-semibold underline underline-offset-2">How we research&nbsp;›</a>
            </p>
          )}
          {reviewBasis && review_basis !== 'research-based' && (
            <p class="mt-2 flex min-h-11 flex-wrap items-center gap-x-1 rounded-lg bg-[#F3F6F2] px-3 text-[13px] leading-[18px] text-forest-900">
              <span>{reviewBasis.visible}</span>
              <a href="/affiliate-disclosure/" class="inline-flex min-h-11 items-center font-semibold underline underline-offset-2">{reviewBasis.summary} <span aria-hidden="true">›</span></a>
            </p>
          )}
        </header>
        )}

        {leadProduct && (
          <section class="mb-4 rounded-lg bg-[#F3F6F2] p-3" aria-labelledby="best-places-to-start">
            <h2 id="best-places-to-start" class="font-display text-lg font-bold leading-6 text-forest-900">Best places to start</h2>
            <div class="mt-2 rounded-[10px] border border-[#D5DDD6] bg-white p-3 lg:flex lg:items-center lg:gap-4">
              <div class="flex min-w-0 flex-1 items-start gap-3">
                {leadProduct.image && (
                  <img src={leadProduct.image} alt="" width="56" height="56" class="h-14 w-14 shrink-0 rounded-md object-cover" />
                )}
                <div class="min-w-0">
                  <p class="text-base font-bold leading-snug text-forest-900">{leadProduct.product}</p>
                  {leadBestFor && <p class="mt-0.5 line-clamp-2 text-[13px] leading-[18px] text-gray-700">Best for: {leadBestFor}</p>}
                </div>
              </div>
              <a
                href={leadProduct.url}
                target="_blank"
                rel="nofollow sponsored noopener"
                data-affiliate-link="true"
                data-product={leadProduct.product}
                data-retailer={leadRetailer}
                data-placement="article-top-shortlist"
                aria-label={`${leadCta} for ${leadProduct.product} (opens in a new tab)`}
                class="mt-3 flex h-12 w-full items-center justify-center rounded-lg bg-[#12301C] text-base font-semibold text-white lg:mt-0 lg:w-auto lg:min-w-[160px] lg:px-4"
              >
                {leadCta}
              </a>
            </div>
            <p class="mt-2 text-xs text-gray-600">We may earn a commission at no cost to you.{rating ? ` ${rating}/10` : ''}</p>
          </section>
        )}

        {buyerGuide && guideModel?.hasPicks && (
          <GuideTopPicks
            heading={guideModel.heading}
            picks={guideModel.top}
            jumpLabel={guideModel.jumpLabel}
            slug={currentSlug}
          />
        )}
        {buyerGuide && guideModel?.hasPicks && (
          <GuideCompare rows={guideModel.rows} scores={guideScores} />
        )}
        {!buyerGuide && quickPickCards.length > 0 && <QuickPicks picks={quickPickCards} />}

        {!buyerGuide && (
          <div class="aspect-video w-full mb-10 rounded-lg overflow-hidden">
            <img src={featured_image} alt={title} width={reviewHeroSize?.width} height={reviewHeroSize?.height} class="w-full h-full object-cover" />
          </div>
        )}

        {hasBuyerIntent && quickPicks.length === 0 && !leadProduct && (
          <ProductBuyBox
            class="mb-10"
            eyebrow="Quick Buyer Shortlist"
            title="Best places to start"
            placement="article-top-shortlist"
            deferImages={buyerGuide}
            numbered
            items={heroCards.map((link) => ({
              product: link.product,
              href: link.url,
              retailer: link.retailer || 'Amazon',
              image: link.image,
              price: link.price,
              pros: link.pros,
              rating: link.rating,
            }))}
          />
        )}

        <!-- Quick Verdict for Reviews -->
        {isReview && (rating || pros || cons) && (
          <div class="mb-10 border-2 border-forest-200 rounded-lg overflow-hidden">
            <div class="bg-forest-800 px-6 py-3">
              <h3 class="text-white font-display font-bold text-lg">Quick Verdict</h3>
            </div>
            <div class="p-6 bg-forest-50/50">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Rating -->
                {rating && (
                  <div class="text-center">
                    <div class="text-5xl font-display font-black text-forest-800">{rating}</div>
                    <div class="text-sm text-gray-500 mt-1">out of 10</div>
                    <div class="mt-2 flex justify-center gap-0.5">
                      {Array.from({ length: 10 }).map((_, i) => (
                        <div class={`w-2.5 h-2.5 rounded-full ${i < Math.round(rating) ? 'bg-gold-500' : 'bg-gray-300'}`}></div>
                      ))}
                    </div>
                    {verdictPrice && <div class="mt-3 text-forest-700 font-bold text-lg">{verdictPrice}</div>}
                  </div>
                )}
                <!-- Pros -->
                {pros && pros.length > 0 && (
                  <div>
                    <h4 class="text-sm font-bold text-forest-700 uppercase tracking-wide mb-2">✅ Pros</h4>
                    <ul class="space-y-1.5">
                      {pros.map((pro: string) => (
                        <li class="text-sm text-gray-700 flex items-start gap-2">
                          <span class="text-forest-500 mt-0.5 flex-shrink-0">+</span>
                          {pro}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                <!-- Cons -->
                {cons && cons.length > 0 && (
                  <div>
                    <h4 class="text-sm font-bold uppercase tracking-wide mb-2 text-[#B91C1C]">❌ Cons</h4>
                    <ul class="space-y-1.5">
                      {cons.map((con: string) => (
                        <li class="text-sm text-gray-700 flex items-start gap-2">
                          <span class="text-red-400 mt-0.5 flex-shrink-0">−</span>
                          {con}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {!(buyerGuide && guideModel?.hasPicks) && <GuideScorecard products={guideScores} />}

        {buyerGuide && description && (
          <p class="text-lg text-gray-600 leading-relaxed mb-6">{description}</p>
        )}
        {buyerGuide && guidePhoto && (
          <>
            <div class="aspect-video mb-10 w-full overflow-hidden rounded-lg bg-gray-100" data-guide-hero-pending>
              <picture>
                <source type="image/avif" data-srcset={guidePhoto.avifSrcset} sizes={guidePhoto.sizes} />
                <source type="image/webp" data-srcset={guidePhoto.webpSrcset} sizes={guidePhoto.sizes} />
                <img
                  src="/images/guide-photo-placeholder.gif"
                  data-src={guidePhoto.fallback}
                  data-srcset={guidePhoto.webpSrcset}
                  alt={title}
                  width={guidePhoto.width}
                  height={guidePhoto.height}
                  sizes={guidePhoto.sizes}
                  class="h-full w-full object-cover"
                  decoding="async"
                  data-guide-hero
                />
              </picture>
            </div>
            <noscript>
              <picture>
                <source type="image/avif" srcset={guidePhoto.avifSrcset} sizes={guidePhoto.sizes} />
                <source type="image/webp" srcset={guidePhoto.webpSrcset} sizes={guidePhoto.sizes} />
                <img src={guidePhoto.fallback} alt={title} width={guidePhoto.width} height={guidePhoto.height} sizes={guidePhoto.sizes} class="mb-10 aspect-video w-full rounded-lg object-cover" />
              </picture>
            </noscript>
          </>
        )}

        <!-- Article Content -->
        <div class="prose prose-lg max-w-none
          prose-headings:font-display prose-headings:text-forest-900 prose-headings:font-bold
          prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-gray-200
          prose-h3:text-xl prose-h3:mt-8
          prose-p:text-gray-700 prose-p:leading-relaxed
          prose-strong:text-forest-900
          prose-a:text-forest-700 hover:prose-a:text-forest-900 prose-a:font-medium prose-a:underline-offset-2
          prose-blockquote:border-l-4 prose-blockquote:border-gold-500 prose-blockquote:bg-gold-50 prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:rounded-r-lg prose-blockquote:not-italic prose-blockquote:text-gray-700
          prose-img:rounded-lg
          prose-li:text-gray-700
        ">
          <slot />
        </div>

        {buyerGuide && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <span id="reading-time" class="text-sm text-gray-600">5 min read</span>
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Share:</span>
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(new URL(Astro.url.pathname, site).toString())}`} target="_blank" rel="noopener" class="w-11 h-11 rounded-full bg-gray-100 hover:bg-blue-100 flex items-center justify-center text-gray-500 hover:text-blue-500 transition-colors" title="Share on X">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <span class="sr-only">Share on X (opens in a new tab)</span>
            </a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(new URL(Astro.url.pathname, site).toString())}`} target="_blank" rel="noopener" class="w-11 h-11 rounded-full bg-gray-100 hover:bg-blue-100 flex items-center justify-center text-gray-500 hover:text-blue-600 transition-colors" title="Share on Facebook">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              <span class="sr-only">Share on Facebook (opens in a new tab)</span>
            </a>
            <button type="button" onclick="navigator.clipboard.writeText(window.location.href);this.textContent='✓'" class="w-11 h-11 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 hover:text-gray-700 transition-colors text-sm" title="Copy link">🔗<span class="sr-only">Copy link</span></button>
          </div>
        )}

        {!buyerGuide && (
          <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-gray-200 pt-6">
            <span class="text-xs font-semibold uppercase tracking-wide text-[#4B5563]">Share</span>
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(new URL(Astro.url.pathname, site).toString())}`} target="_blank" rel="noopener" class="flex h-11 w-11 items-center justify-center rounded-full bg-[#F3F4F6] text-[#4B5563]" title="Share on X">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <span class="sr-only">Share on X (opens in a new tab)</span>
            </a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(new URL(Astro.url.pathname, site).toString())}`} target="_blank" rel="noopener" class="flex h-11 w-11 items-center justify-center rounded-full bg-[#F3F4F6] text-[#4B5563]" title="Share on Facebook">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              <span class="sr-only">Share on Facebook (opens in a new tab)</span>
            </a>
            <button type="button" onclick="navigator.clipboard.writeText(window.location.href);this.textContent='✓'" class="flex h-11 w-11 items-center justify-center rounded-full bg-[#F3F4F6] text-sm text-[#4B5563]" title="Copy link">🔗<span class="sr-only">Copy link</span></button>
          </div>
        )}

        <!-- Tags -->
        {tags && tags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-gray-200">
            <div class="flex flex-wrap gap-2">
              {tags.map((tag: string) => (
                <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded-full">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Affiliate Links -->
        {buyerCards.length > 0 && (
          <ProductBuyBox
            class="mt-10"
            eyebrow="Where to Buy"
            title="Current retailer options"
            placement="article-bottom-buy-box"
            deferImages={buyerGuide}
            items={buyerCards.map((link) => ({
              product: link.product,
