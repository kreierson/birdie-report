---
export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  guideTemplate?: boolean;
  homeRouter?: boolean;
}

const { title, description, image, canonical, noindex = false, guideTemplate = false, homeRouter = false } = Astro.props;
const site = 'https://www.birdiereport.com';
const defaultImage = '/images/birdie-report-og.jpg';
const canonicalUrl = canonical || new URL(Astro.url.pathname, site);

const currentPath = Astro.url.pathname;

const desktopNav = [
  { href: '/best/', label: 'Best Of', guideName: 'Best Of', placement: 'home-pill' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/tips/', label: 'Tips' },
  { href: '/deals/', label: 'Deals', guideName: 'Deals', placement: 'home-pill' },
  { href: '/blog/best-golf-gifts/', label: 'Gift Guide' },
  { href: '/tools/', label: 'Tools' },
  { href: '/courses/', label: 'Courses' },
];

const menuNav = [
  { href: '/best/', label: 'Best Of', guideName: 'Best Of', placement: 'home-pill' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/news/', label: 'News' },
  { href: '/tips/', label: 'Tips' },
  { href: '/deals/', label: 'Deals', guideName: 'Deals', placement: 'home-pill' },
  { href: '/courses/', label: 'Courses' },
  { href: '/versus/', label: 'Versus' },
  { href: '/opinion/', label: 'Opinion' },
  { href: '/tools/', label: 'Tools' },
];
---

<!DOCTYPE html>
<html lang="en" class:list={['h-full', guideTemplate && 'no-js']}>
  <head>
    {guideTemplate && <script is:inline>document.documentElement.classList.remove('no-js')</script>}
    <script is:inline src="/scripts/analytics.js" defer></script>
    {guideTemplate && <script is:inline src="/scripts/guide-template.js" defer></script>}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(image || defaultImage, site)} />
    <meta property="og:site_name" content="The Birdie Report" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image || defaultImage, site)} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.ico" />

    <link rel="preload" href="/fonts/playfair-display-900-latin.woff2" as="font" type="font/woff2" crossorigin>
    <style is:inline>
      @font-face {
        font-family: Inter;
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url("/fonts/inter-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Playfair Display";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/playfair-display-700-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Playfair Display";
        font-style: normal;
        font-weight: 900;
        font-display: swap;
        src: url("/fonts/playfair-display-900-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>
    
    <script type="application/ld+json">
      [{
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "The Birdie Report",
        "url": "https://www.birdiereport.com",
        "logo": "https://www.birdiereport.com/logo.jpg",
        "description": "Golf equipment reviews, tips, and deals to help you improve your game and save money.",
        "founder": {
          "@type": "Person",
          "name": "Kyle Reierson"
        },
        "sameAs": [
          "https://x.com/kreierson22"
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "The Birdie Report",
        "url": "https://www.birdiereport.com"
      }]
    </script>
  <style is:global>
      body { padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); }
      main { overflow-wrap: anywhere; }
      footer { padding-bottom: env(safe-area-inset-bottom); }
      .no-js [data-guide-hero-pending], .no-js [data-guide-defer]{display:none}
      a:focus-visible, button:focus-visible { outline: 3px solid #b8860b; outline-offset: 3px; }
      .home-router a:focus-visible, .home-router button:focus-visible { outline: 2px solid #1A472A; outline-offset: 2px; }
      .home-router header a:focus-visible, .home-router header button:focus-visible, .home-router footer a:focus-visible { outline-color: #D4AF37; }
      .home-router a:active { background-color: #12301C; color: #fff; }
      @media (prefers-reduced-motion: reduce) {
        .home-router * { transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  
  <body class:list={['h-full bg-white text-gray-900 font-body antialiased selection:bg-gold-200 selection:text-forest-900', homeRouter && 'home-router']}>
    <div class="min-h-full">
      <header class="sticky top-0 z-50 border-b border-white/10 bg-forest-900 xl:border-gray-200 xl:bg-white">
        <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:text-forest-900">Skip to content</a>
        <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 sm:px-6 lg:px-8">
          <a href="/" class="mr-auto inline-flex h-10 shrink-0 items-center">
            <img src="/logo.jpg" alt="The Birdie Report" width="1280" height="436" class="h-10 w-auto max-w-[46vw] rounded-sm bg-white object-contain" />
          </a>
          <nav class="hidden items-center xl:flex" aria-label="Primary">
            {desktopNav.map((item) => (
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center px-2.5 text-[13px] font-semibold uppercase tracking-wide text-forest-900"
                aria-current={currentPath === item.href || currentPath.startsWith(item.href) ? 'page' : undefined}
                data-guide-link={item.guideName ? 'true' : undefined}
                data-guide-name={item.guideName}
                data-placement={item.placement}
              >{item.label}</a>
            ))}
          </nav>
          <a href="/search/" class="inline-flex min-h-11 items-center text-sm font-semibold text-gold-500 xl:text-forest-900">Search</a>
          <button
            type="button"
            id="mobile-menu-btn"
            class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-gold-500 xl:hidden"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            Menu
          </button>
        </div>
        <nav id="mobile-menu" class="hidden max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain border-t border-white/15 bg-forest-900 px-4 py-2 xl:hidden" aria-label="Menu">
          {menuNav.map((item) => (
            <a
              href={item.href}
              class="flex min-h-11 items-center text-base font-semibold text-white"
              data-guide-link={item.guideName ? 'true' : undefined}
              data-guide-name={item.guideName}
              data-placement={item.placement}
            >{item.label}</a>
          ))}
        </nav>
      </header>

      <script>
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        btn?.addEventListener('click', () => {
          menu?.classList.toggle('hidden');
          btn.setAttribute('aria-expanded', String(!menu?.classList.contains('hidden')));
        });
      </script>
      <script>
        const imageFallback = '/images/hero-golf.jpg';
        document.addEventListener('error', (event) => {
          const img = event.target;
          if (!(img instanceof HTMLImageElement)) return;
          if (img.dataset.fallbackApplied === 'true') return;
          img.dataset.fallbackApplied = 'true';
          img.src = imageFallback;
        }, true);
      </script>

      <main id="content">
        <slot />
      </main>

      {homeRouter && <slot name="footer" />}
      {!homeRouter && <>
      <!-- Footer -->
      <footer class="bg-forest-900 text-white mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
            <!-- Brand -->
            <div class="col-span-1 md:col-span-2">
              <h3 class="text-2xl font-display font-bold text-white mb-4">The Birdie Report</h3>
              <p class="text-white/70 text-sm mb-6 max-w-md">
                Honest golf equipment reviews, tips to improve your game, and the best deals on gear. 
                Written by Kyle Reierson. Honest reviews, no corporate BS.
              </p>
              
              <div class="mb-6">
                <h4 class="text-gold-400 text-sm font-semibold mb-3">Find your next upgrade</h4>
                <a href="/best/" class="inline-flex px-5 py-3 bg-gold-500 text-forest-900 text-base font-bold rounded-md hover:bg-gold-400 transition-colors">Explore buying guides</a>
              </div>
            </div>
            
            <!-- Quick Links -->
            <div>
              <h3 class="text-gold-400 text-xs font-semibold uppercase tracking-wider mb-4">Content</h3>
              <ul class="space-y-2.5 text-sm text-white/70">
                <li><a href="/best/" class="hover:text-gold-400 transition-colors">Best Of Guides</a></li>
                <li><a href="/tools/golf-club-gapping-calculator/" class="hover:text-gold-400 transition-colors">Club Gapping Calculator</a></li>
                <li><a href="/reviews/" class="hover:text-gold-400 transition-colors">Equipment Reviews</a></li>
                <li><a href="/tips/" class="hover:text-gold-400 transition-colors">Golf Tips</a></li>
                <li><a href="/deals/" class="hover:text-gold-400 transition-colors">Deals & Savings</a></li>
                <li><a href="/courses/" class="hover:text-gold-400 transition-colors">Course Guide</a></li>
              </ul>
            </div>
            
            <!-- Legal -->
            <div>
              <h3 class="text-gold-400 text-xs font-semibold uppercase tracking-wider mb-4">Info</h3>
              <ul class="space-y-2.5 text-sm text-white/70">
                <li><a href="/about/" class="hover:text-gold-400 transition-colors">About</a></li>
                <li><a href="/contact/" class="hover:text-gold-400 transition-colors">Contact</a></li>
                <li><a href="/affiliate-disclosure/" class="hover:text-gold-400 transition-colors">Affiliate Disclosure</a></li>
                <li><a href="/privacy/" class="hover:text-gold-400 transition-colors">Privacy Policy</a></li>
              </ul>
            </div>
          </div>
          
          <!-- Bottom -->
          <div class="border-t border-forest-700 pt-8 mt-12 flex flex-col sm:flex-row justify-between items-center">
            <p class="text-sm text-white/50">
              © 2026 The Birdie Report. All rights reserved.
            </p>
            <p class="text-xs text-white/50 mt-2 sm:mt-0">
              As an Amazon Associate and affiliate partner, we earn from qualifying purchases.
            </p>
          </div>
        </div>
      </footer>
      </>}
    </div>
  </body>
</html>
