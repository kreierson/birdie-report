---
import BaseLayout from '../layouts/BaseLayout.astro';
import { archiveHref, ARCHIVE_PAGE_SIZE } from '../utils/archive.mjs';
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; current: number; total: number; last: number; }
const { posts, current, total, last } = Astro.props;
const title = current === 1 ? 'All Articles | The Birdie Report' : `All Articles — Page ${current} | The Birdie Report`;
---
<BaseLayout title={title} description={`Browse golf reviews, comparisons, tips and course guides. Page ${current} of ${last}, newest first.`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">All Articles{current > 1 && ` — Page ${current}`}</h1>
      <p class="text-xl text-gray-600">Everything we've published, newest first.</p>
      <p class="text-gray-600 mt-3">Articles {(current - 1) * ARCHIVE_PAGE_SIZE + 1}–{Math.min(current * ARCHIVE_PAGE_SIZE, total)} of {total}</p>
    </div>
    <nav aria-label="Archive navigation" class="flex flex-wrap justify-center items-center gap-4 mb-8">
      {current > 1 && <a class="underline p-3" href={archiveHref(current - 1)} rel="prev">← Newer articles</a>}
      <span>Page {current} of {last}</span>
      {current < last && <a class="underline p-3" href={archiveHref(current + 1)} rel="next">Older articles →</a>}
    </nav>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <article class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
          <a href={`/blog/${post.slug}/`}>
            <img 
              src={post.data.featured_image} 
              alt={post.data.title}
              class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </a>
          <div class="p-6">
            <div class="flex items-center space-x-2 text-sm text-gray-500 mb-2">
              <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-medium capitalize">
                {post.data.category}
              </span>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{post.data.date.toLocaleDateString('en-US', { timeZone: 'UTC' })}</time>
            </div>
            <h2 class="text-xl font-semibold text-gray-900 mb-3 line-clamp-2">
              <a href={`/blog/${post.slug}/`} class="hover:text-green-700 transition-colors">
                {post.data.title}
              </a>
            </h2>
            <p class="text-gray-600 text-sm line-clamp-3">{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>

    <nav aria-label="Archive pages" class="mt-10 border-t pt-6">
      <p class="text-center text-gray-600 mb-4">Browse every page</p>
      <ol class="flex flex-wrap justify-center gap-2">
        {Array.from({length: last}, (_, i) => i + 1).map(page => (
          <li><a href={archiveHref(page)} aria-current={page === current ? 'page' : undefined}
            aria-label={`Page ${page}`} class={`inline-flex min-w-11 min-h-11 items-center justify-center rounded border px-3 py-2 ${page === current ? 'bg-forest-800 text-white' : 'border-gray-300 hover:bg-gray-100'}`}>{page}</a></li>
        ))}
      </ol>
    </nav>
  </div>
</BaseLayout>
