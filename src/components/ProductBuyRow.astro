---
import { awardKicker, bestForLine, priceCheckAccessibleName, priceCheckCta, storedPriceLine } from '../utils/product-buy.mjs';

interface Props {
  as?: 'div' | 'li';
  product: string;
  href: string;
  retailer?: string;
  placement: string;
  image?: string;
  price?: string;
  pros?: string[];
  why?: string;
  award?: string;
  rating?: number;
  rank?: number;
  cta?: string;
}

const {
  as: Tag = 'div',
  product,
  href,
  retailer = 'Amazon',
  placement,
  image = '',
  price,
  pros,
  why,
  award,
  rating,
  rank,
  cta: ctaOverride,
} = Astro.props;

const cta = ctaOverride || priceCheckCta(retailer);
const accessibleName = priceCheckAccessibleName(cta, product);
const bestFor = bestForLine({ award, why, pros });
const kicker = awardKicker(award, bestFor);
const priceLine = storedPriceLine(price);
const showRating = typeof rating === 'number' && Number.isFinite(rating);
---

<Tag class:list={[
  'bg-white p-4 sm:p-5 grid gap-x-4 gap-y-3 items-center',
  image
    ? 'grid-cols-[4.5rem_minmax(0,1fr)] sm:grid-cols-[4.5rem_minmax(0,1fr)_auto]'
    : 'grid-cols-1 sm:grid-cols-[minmax(0,1fr)_auto]',
]}>
  {image && (
    <div class="h-[4.5rem] w-[4.5rem] shrink-0 overflow-hidden rounded-md border border-forest-100 bg-forest-50">
      <img src={image} alt={product} class="h-full w-full object-contain" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="min-w-0">
    {(rank || kicker || showRating) && (
      <div class="flex flex-wrap items-center gap-2 mb-1">
        {rank && (
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-forest-800 text-white text-xs font-bold">{rank}</span>
        )}
        {kicker && <p class="text-sm font-bold text-forest-800">{kicker}</p>}
        {showRating && <span class="text-sm font-semibold text-gold-700">{rating}/10</span>}
      </div>
    )}
    <h3 class="font-bold text-gray-950 leading-snug">{product}</h3>
    {bestFor && (
      <p class="text-sm text-gray-700 mt-1 leading-snug line-clamp-2">
        <span class="font-semibold text-forest-800">Best for:</span> {bestFor}
      </p>
    )}
    {priceLine && <p class="text-sm font-semibold text-forest-900 mt-1">{priceLine}</p>}
  </div>
  <a
    href={href}
    target="_blank"
    rel="nofollow sponsored noopener"
    data-affiliate-link="true"
    data-product={product}
    data-retailer={retailer}
    data-placement={placement}
    aria-label={accessibleName}
    class:list={[
      'inline-flex min-h-11 w-full sm:w-auto items-center justify-center px-5 py-3 bg-gold-500 text-forest-900 rounded-md hover:bg-gold-400 transition-colors text-sm font-bold text-center',
      image ? 'col-span-2 sm:col-span-1 sm:col-start-3 sm:row-start-1 sm:self-center' : '',
    ]}
  >
    {cta}
  </a>
</Tag>
