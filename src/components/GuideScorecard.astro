---
export interface Props {
  products?: Array<{
    name: string;
    rating?: number | null;
    pros?: string[];
    cons?: string[];
  }>;
}

const { products = [] } = Astro.props;
---

{products.length > 0 && (
  <section class="mb-10 border-2 border-forest-200 rounded-lg overflow-hidden" aria-label="Scores in this guide">
    <div class="bg-forest-800 px-6 py-3">
      <h2 class="text-white font-display font-bold text-lg">Scores in this guide</h2>
    </div>
    <div class="divide-y divide-forest-100">
      {products.map((product) => (
        <div class="p-6 bg-forest-50/40">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-display font-bold text-forest-900">{product.name}</h3>
            {product.rating && <p class="text-gold-700 font-bold">{product.rating}/10</p>}
          </div>
          {product.pros && product.pros.length > 0 && (
            <div class="mt-3">
              <h4 class="text-sm font-bold text-forest-700 uppercase tracking-wide mb-2">Pros</h4>
              <ul class="space-y-1.5">
                {product.pros.map((pro) => (
                  <li class="text-sm text-gray-700 flex items-start gap-2">
                    <span class="text-forest-500 mt-0.5 flex-shrink-0">+</span>
                    {pro}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {product.cons && product.cons.length > 0 && (
            <div class="mt-3">
              <h4 class="text-sm font-bold text-red-600 uppercase tracking-wide mb-2">Cons</h4>
              <ul class="space-y-1.5">
                {product.cons.map((con) => (
                  <li class="text-sm text-gray-700 flex items-start gap-2">
                    <span class="text-red-400 mt-0.5 flex-shrink-0">−</span>
                    {con}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
)}
