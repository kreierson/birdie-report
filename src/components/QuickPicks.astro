---
import ProductBuyBox from './ProductBuyBox.astro';
import { QUICK_PICKS_PLACEMENT } from '../utils/quick-picks.mjs';

const { picks = [] } = Astro.props;
---

<ProductBuyBox
  eyebrow="Quick picks"
  title="Our top picks at a glance"
  titleId="quick-picks-title"
  placement={QUICK_PICKS_PLACEMENT}
  ordered
  class="mb-8"
  marker="quick-picks"
  items={picks.map((pick) => ({
    product: pick.product,
    href: pick.url,
    retailer: pick.retailer,
    image: pick.image,
    price: pick.price,
    why: pick.why,
    award: pick.award,
    cta: pick.cta,
  }))}
/>
