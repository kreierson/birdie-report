---
import { isDirectAmazonProductUrl, normalizeAffiliateUrl } from '../utils/affiliate';
import { BF_HUB_PLACEMENT } from '../utils/black-friday.mjs';

interface Props {
  product: string;
  url: string;
  retailer?: string;
}

const { product, url, retailer = 'Amazon' } = Astro.props;
if (!product?.trim() || !url?.trim()) {
  throw new Error('BlackFridayCta requires product and url');
}

const href = normalizeAffiliateUrl({ url }, { category: 'deals' });
const direct = isDirectAmazonProductUrl(href);
const cta = direct ? `See this product on ${retailer}` : `See options on ${retailer}`;
const note = direct
  ? "Opens one verified Amazon product page. Check today's price, and confirm the color and the seller."
  : "Opens Amazon search results. Check today's price, and confirm the model and the seller.";
---

<div class="bf-hub-cta not-prose my-4">
  <a
    href={href}
    target="_blank"
    rel="nofollow sponsored noopener"
    data-affiliate-link="true"
    data-product={product}
    data-retailer={retailer}
    data-placement={BF_HUB_PLACEMENT}
    aria-label={`${cta} for ${product} (opens in a new tab)`}
    class="inline-flex items-center justify-center min-h-11 px-5 py-3 bg-forest-700 text-white rounded-md hover:bg-forest-800 text-sm font-bold text-center"
  >
    {cta}
  </a>
  <p class="text-xs text-gray-500 mt-2 mb-0">{note}</p>
</div>

<style>
  .bf-hub-cta a:focus-visible {
    outline: 3px solid #b8860b;
    outline-offset: 3px;
  }
</style>
