---
import { getCollection } from 'astro:content';
import DealFreshness from './DealFreshness.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { sectionTrail } from '../utils/breadcrumbs.mjs';
import { dealAsOfKey, dealSnapshot } from '../utils/listing.mjs';
import { listingImage } from '../utils/guide-images.mjs';

export interface Props {
  category: string;
  title: string;
  description: string;
  accentColor: string;  // e.g. 'forest', 'blue', 'orange', 'emerald', 'purple', 'rose', 'red'
  badgeLabel: string;
  badgeClass: string;   // e.g. 'bg-forest-700 text-white'
  page?: number;
  pageSize?: number;
}

const { category, title, description, accentColor, badgeLabel, badgeClass, page = 1, pageSize = 0 } = Astro.props;

const allPosts = await getCollection('blog').catch(() => []);
const posts = allPosts
  .filter(post => post.data.category === category)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const heroPost = posts[0];
const remaining = posts.slice(1);
const paged = pageSize > 0;
const pageCount = paged ? Math.max(1, Math.ceil(remaining.length / pageSize)) : 1;
const currentPage = Math.min(Math.max(1, page), pageCount);
const breadcrumbs = sectionTrail(
  category,
  paged && currentPage > 1 ? { name: `Page ${currentPage}`, href: `/${category}/page/${currentPage}/` } : null,
);
const visible = paged ? remaining.slice((currentPage - 1) * pageSize, currentPage * pageSize) : remaining;
const showHero = !paged || currentPage === 1;
const heroPhoto = heroPost ? listingImage(heroPost.data.featured_image, '100vw') : null;
const pageHref = (n: number) => n === 1 ? `/${category}/` : `/${category}/page/${n}/`;
const cards = visible.map((post, i) => ({
  post,
  photo: listingImage(post.data.featured_image),
  eager: !showHero && i === 0,
  wide: showHero && i === 0,
}));
const pager = Array.from({ length: pageCount }, (_, index) => {
  const n = index + 1;
  return { n, href: pageHref(n), here: n === currentPage };
});
const subcategories = [...new Set(posts.map(p => p.data.subcategory).filter(Boolean))];

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}

const heroDeal = heroPost && category === 'deals' ? dealSnapshot(heroPost) : null;
const dealPosts = category === 'deals' ? posts : [];
const expiredDealCount = dealPosts.filter((post) => dealSnapshot(post)?.expired).length;

const borderColor: Record<string, string> = {
  forest: 'border-forest-600',
  blue: 'border-blue-500',
  orange: 'border-orange-500',
  emerald: 'border-emerald-500',
  purple: 'border-purple-500',
  rose: 'border-rose-500',
  red: 'border-red-500',
  gold: 'border-gold-500',
};
---

<Breadcrumbs items={breadcrumbs} />

<!-- Hero -->
{showHero && heroPost && (
  <section class="relative bg-forest-950 overflow-hidden">
    <div class="absolute inset-0">
      <img src={heroPhoto.src} srcset={heroPhoto.srcset} sizes={heroPhoto.sizes} alt={heroPost.data.title} width={heroPhoto.width} height={heroPhoto.height} fetchpriority="high" class="w-full h-full object-cover opacity-35" />
      <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-forest-950/60 to-forest-950/20"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl">
        <span class={`inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm mb-4 ${badgeClass}`}>
          {badgeLabel}
        </span>
        <h1 class="text-3xl md:text-5xl font-display font-black text-white leading-tight mb-4">
          {title}
        </h1>
        <p class="text-lg text-white/70 mb-6 max-w-2xl">{description}</p>

        <slot name="lead" />
        
        <!-- Featured article -->
        <div class="bg-white/10 backdrop-blur rounded-lg p-5 mt-8 max-w-xl" data-deal-as-of={heroDeal ? dealAsOfKey(heroDeal.asOf) : undefined}>
          <p class="text-gold-400 text-xs font-bold uppercase tracking-wider mb-2" data-deal-state-label={heroDeal ? true : undefined}>{heroDeal?.expired ? 'Expired' : 'Featured'}</p>
          <h2 class="text-xl md:text-2xl font-display font-bold text-white mb-2 leading-snug">
            <a href={`/blog/${heroPost.slug}/`} class="hover:text-gold-300 transition-colors">
              {heroPost.data.title}
            </a>
          </h2>
          <p class="text-white/60 text-sm line-clamp-2">{heroPost.data.description}</p>
          {heroDeal && (
            <p data-deal-expired-note hidden={!heroDeal.expired} class="text-sm text-white mt-3">Checked {formatDate(heroDeal.asOf)}. This deal check has expired. Confirm any price with the retailer.</p>
          )}
          <div class="flex items-center gap-3 mt-3 text-sm text-white/80">
            <time class="text-sm text-white/80" datetime={heroPost.data.date.toISOString()}>{formatDate(heroPost.data.date)}</time>
            {heroPost.data.rating && <span class="text-gold-400 font-semibold">⭐ {heroPost.data.rating}/10</span>}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

{!showHero && heroPost && (
  <section class="bg-forest-900 py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-black text-white md:text-5xl">{title}</h1>
      <p class="mt-3 max-w-2xl text-lg text-white/70">{description}</p>
    </div>
  </section>
)}

{!heroPost && (
  <section class="bg-forest-900 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class:list={['mb-4 inline-block rounded-sm px-3 py-1 text-xs font-bold uppercase tracking-wider', badgeClass]}>
        {badgeLabel}
      </span>
      <h1 class="text-3xl md:text-5xl font-display font-black text-white mb-4">{title}</h1>
      <p class="text-lg text-white/70 max-w-2xl mx-auto">{description}</p>
      <slot name="lead" />
    </div>
  </section>
)}

<!-- Subcategory filter -->
{subcategories.length > 0 && (
  <div class="bg-gray-50 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="filter-row flex items-center gap-2 overflow-x-auto">
        <span class="whitespace-nowrap text-[11px] font-bold uppercase tracking-[0.08em] text-[#4B5563]">Filter</span>
        <button class="category-filter-btn active inline-flex h-11 min-w-11 shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-[#1A472A] px-4 text-sm font-semibold text-white" data-filter="all">All</button>
        {subcategories.map(sub => (
          <button class="category-filter-btn inline-flex h-11 min-w-11 shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-[#F3F6F2] px-4 text-sm font-semibold capitalize text-[#12301C]" data-filter={sub}>
            {sub?.replace('-', ' ')}
          </button>
        ))}
      </div>
    </div>
  </div>
)}

<!-- Articles Grid -->
<section class="py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {expiredDealCount > 0 && (
      <p class="mb-8 rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-sm leading-relaxed text-orange-950" role="note">
        {expiredDealCount === dealPosts.length
          ? 'Every deal check in this archive is past its date. The articles stay up, and each one is marked expired. Prices were only confirmed on the date shown.'
          : 'Deal checks past their date are marked expired. Prices were only confirmed on the date shown.'}
      </p>
    )}
    {cards.length > 0 ? (
      <div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="articles-grid">
        {cards.map(({ post, photo, eager, wide }) => (
          <article
            class:list={['group article-card', wide && 'md:col-span-2']}
            data-subcategory={post.data.subcategory || ''}
            data-deal-as-of={category === 'deals' ? dealAsOfKey(dealSnapshot(post).asOf) : undefined}
          >
            <a href={`/blog/${post.slug}/`} class="block relative overflow-hidden rounded-lg mb-3">
              <img 
                src={photo.src}
                srcset={photo.srcset}
                sizes={photo.sizes}
                alt={post.data.title}
                width={photo.width}
                height={photo.height}
                class:list={['w-full object-cover transition-transform duration-500 group-hover:scale-105', wide ? 'h-52 md:h-72' : 'h-48']}
                loading={eager ? undefined : 'lazy'}
                fetchpriority={eager ? 'high' : undefined}
                decoding="async"
              />
              {post.data.rating && (
                <div class="absolute top-3 right-3 bg-forest-800/90 text-gold-400 text-sm font-bold px-2.5 py-1 rounded">
                  {post.data.rating}/10
                </div>
              )}
            </a>
            <div>
              <div class="flex items-center gap-2 mb-2">
                {category === 'deals' && (
                  <span data-deal-expired-badge hidden={!dealSnapshot(post)?.expired} class="text-[10px] font-bold uppercase tracking-wider text-orange-800 bg-orange-100 px-1.5 py-0.5 rounded-sm">Expired</span>
                )}
                {post.data.subcategory && (
                  <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500">{post.data.subcategory.replace('-', ' ')}</span>
                )}
                <time class="text-sm text-[#4B5563]" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </div>
              <h3 class:list={['font-semibold leading-snug text-gray-900 line-clamp-2', wide ? 'font-display text-xl md:text-2xl' : 'text-base']}>
                <a href={`/blog/${post.slug}/`} class="hover:text-forest-700 transition-colors">
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-2 line-clamp-2 text-sm text-gray-600">{post.data.description}</p>
              {post.data.price && <p class="text-forest-700 font-semibold text-sm mt-2">{post.data.price}</p>}
            </div>
          </article>
        ))}
      </div>
      {paged && pageCount > 1 && (
        <nav class="mt-10 flex flex-wrap items-center gap-2" aria-label="Pagination">
          {currentPage > 1 && <a rel="prev" href={pageHref(currentPage - 1)} class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-4 text-sm font-semibold text-forest-900">Previous</a>}
          {pager.map((item) => (
            <a href={item.href} aria-current={item.here ? 'page' : undefined} class:list={['inline-flex h-11 min-w-11 items-center justify-center rounded-full px-3 text-sm font-semibold', item.here ? 'bg-[#1A472A] text-white' : 'bg-[#F3F6F2] text-[#12301C]']}>{item.n}</a>
          ))}
          {currentPage < pageCount && <a rel="next" href={pageHref(currentPage + 1)} class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-4 text-sm font-semibold text-forest-900">Next</a>}
        </nav>
      )}
      </div>
    ) : (
      <p class="text-center text-gray-500 text-lg py-12">Content coming soon. Check back shortly!</p>
    )}

    <!-- Slot for extra content (testing process, etc.) -->
    <slot />
  </div>
</section>

<DealFreshness />

<script>
document.addEventListener('DOMContentLoaded', () => {
  const btns = document.querySelectorAll('.category-filter-btn');
  const cards = document.querySelectorAll('.article-card');
  
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;
      btns.forEach(b => {
        b.classList.remove('bg-[#1A472A]', 'text-white', 'active');
        b.classList.add('bg-[#F3F6F2]', 'text-[#12301C]');
      });
      btn.classList.remove('bg-[#F3F6F2]', 'text-[#12301C]');
      btn.classList.add('bg-[#1A472A]', 'text-white', 'active');
      
      cards.forEach(card => {
        const sub = (card as HTMLElement).dataset.subcategory;
        if (filter === 'all' || sub === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
});
</script>

<style>
  .filter-row { scrollbar-width: none; }
  .filter-row::-webkit-scrollbar { display: none; }
</style>
