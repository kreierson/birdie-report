---
const { post } = Astro.props;
const date = post?.date || '';
---
<article class="comparison-card rounded-lg border border-gray-200 bg-white overflow-hidden">
  <a data-card-link href={post?.href}><img data-card-image src={post?.image} alt={post?.title || ''} loading="lazy" class="w-full h-48 object-cover" /></a>
  <div class="p-5">
    <div class="flex flex-wrap gap-2 text-xs text-gray-500 mb-3">
      <span data-card-category class="capitalize">{post?.subcategory.replaceAll('-', ' ')}</span>
      <time data-card-date datetime={date}>{date && new Date(date).toLocaleDateString('en-US', {timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric'})}</time>
    </div>
    <h2 class="text-xl font-display font-bold leading-snug text-forest-900"><a data-card-title href={post?.href}>{post?.title}</a></h2>
    <p data-card-description class="text-sm text-gray-600 mt-3">{post?.description}</p>
  </div>
</article>
