---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Find the right gear for your game',
  description = 'Compare the features that matter, understand the tradeoffs, and narrow your shortlist before you buy.',
} = Astro.props;

const opportunities = [
  {
    label: 'Practice at home',
    title: 'Launch monitors',
    href: '/blog/best-golf-launch-monitors-2026/',
    note: 'Compare space requirements, ongoing costs, and indoor or outdoor use.',
  },
  {
    label: 'Know your distance',
    title: 'Rangefinders',
    href: '/blog/best-rangefinders-2026/',
    note: 'Choose between slope, stabilization, clear optics, and a lower price.',
  },
  {
    label: 'Match your ball',
    title: 'Golf balls',
    href: '/blog/best-golf-balls-2026/',
    note: 'Find a ball that fits your feel preference, short game, and budget.',
  },
  {
    label: 'Walk comfortably',
    title: 'Walking shoes',
    href: '/blog/best-golf-shoes-walking-2026/',
    note: 'Compare fit, support, waterproofing, and traction for walking rounds.',
  },
];
---

<section class="py-12 bg-forest-50 border-y border-forest-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-7">
      <p class="text-xs font-bold uppercase tracking-wide text-forest-700 mb-2">Buying guides</p>
      <h2 class="text-2xl md:text-3xl font-display font-bold text-forest-900">{title}</h2>
      <p class="text-gray-600 mt-3">{description}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {opportunities.map((item) => (
        <a href={item.href} class="group block bg-white border border-forest-100 rounded-lg p-5 hover:border-gold-400 hover:shadow-md transition-all">
          <span class="text-sm font-bold uppercase tracking-wide text-gold-700">{item.label}</span>
          <h3 class="text-lg font-display font-bold text-forest-900 mt-2 group-hover:text-forest-700">{item.title}</h3>
          <p class="text-sm text-gray-600 mt-2 leading-relaxed">{item.note}</p>
        </a>
      ))}
    </div>
  </div>
</section>
