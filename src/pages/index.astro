---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { mostUsedGuides, showsPriceClaim, tilesFor } from '../utils/home-router.mjs';

const allPosts = await getCollection('blog').catch(() => []);
const sorted = allPosts.sort((a, b) => new Date(b.data.updated || b.data.date).getTime() - new Date(a.data.updated || a.data.date).getTime());
const tiles = tilesFor();
const mostUsed = mostUsedGuides();
const reviews = sorted
  .filter((post) => post.data.category === 'reviews' && !showsPriceClaim(post.data.title) && !showsPriceClaim(post.data.description || ''))
  .slice(0, 3);

const desktopNav = [
  { href: '/best/', label: 'Best Of', guideName: 'Best Of', placement: 'home-pill' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/tips/', label: 'Tips' },
  { href: '/deals/', label: 'Deals', guideName: 'Deals', placement: 'home-pill' },
  { href: '/blog/best-golf-gifts/', label: 'Gift Guide' },
  { href: '/tools/', label: 'Tools' },
  { href: '/courses/', label: 'Courses' },
];

const menuNav = [
  { href: '/best/', label: 'Best Of', guideName: 'Best Of', placement: 'home-pill' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/news/', label: 'News' },
  { href: '/tips/', label: 'Tips' },
  { href: '/deals/', label: 'Deals', guideName: 'Deals', placement: 'home-pill' },
  { href: '/courses/', label: 'Courses' },
  { href: '/versus/', label: 'Versus' },
  { href: '/opinion/', label: 'Opinion' },
  { href: '/tools/', label: 'Tools' },
];

const moreWays = [
  { href: '/blog/best-golf-gifts/', label: 'Golf Gift Guide', guideName: '2026 golf gift guide', placement: 'home-gift-guide', slug: 'best-golf-gifts', module: 'home_more_ways', position: 1 },
  { href: '/deals/', label: 'Deals hub', guideName: 'Deals hub', placement: 'home-deals-hub', module: 'home_more_ways', position: 2 },
  { href: '/tools/golf-club-gapping-calculator/', label: 'Club Gapping Calculator', guideName: 'Golf club gapping calculator', placement: 'home-pill', module: 'home_more_ways', position: 3 },
];

const footerLinks = [
  { href: '/best/', label: 'Best Of' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/tips/', label: 'Tips' },
  { href: '/deals/', label: 'Deals' },
  { href: '/tools/', label: 'Tools' },
  { href: '/courses/', label: 'Courses' },
  { href: '/news/', label: 'News' },
  { href: '/versus/', label: 'Versus' },
  { href: '/opinion/', label: 'Opinion' },
  { href: '/tools/golf-club-gapping-calculator/', label: 'Club Gapping Calculator' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/privacy/', label: 'Privacy' },
];

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}

const tileClass = 'flex min-h-12 items-center justify-center gap-1 rounded-md border border-forest-900 bg-[#F3F6F2] px-3 text-center text-sm font-semibold text-forest-900 xl:min-h-11 xl:w-auto xl:rounded-full xl:border-0 xl:px-4';
const rowClass = 'flex min-h-12 items-center justify-between gap-3 border-b border-[#12301C]/10 py-1 text-base font-semibold text-forest-900';
const moreClass = 'flex min-h-11 items-center gap-2 text-base font-semibold text-forest-900';
---

<BaseLayout
  homeRouter
  title="The Birdie Report — Golf Equipment Reviews, Tips & Deals"
  description="Honest golf equipment reviews, instruction tips, and the best deals on golf gear. No BS, just better golf."
>
  <header slot="header" class="sticky top-0 z-50 border-b border-white/10 bg-forest-900 xl:border-gray-200 xl:bg-white">
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:text-forest-900">Skip to content</a>
    <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 sm:px-6 lg:px-8">
      <a href="/" class="mr-auto inline-flex h-10 items-center">
        <img src="/logo.jpg" alt="The Birdie Report" width="1280" height="436" class="h-10 w-auto max-w-[46vw] rounded-sm bg-white object-contain" />
      </a>
      <nav class="hidden items-center xl:flex" aria-label="Primary">
        {desktopNav.map((item) => (
          <a
            href={item.href}
            class="inline-flex min-h-11 items-center px-2.5 text-[13px] font-semibold uppercase tracking-wide text-forest-900"
            data-guide-link={item.guideName ? 'true' : undefined}
            data-guide-name={item.guideName}
            data-placement={item.placement}
          >{item.label}</a>
        ))}
      </nav>
      <a href="/search/" class="inline-flex min-h-11 items-center text-sm font-semibold text-gold-500 xl:text-forest-900">Search</a>
      <button
        type="button"
        id="home-menu-btn"
        class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-gold-500 xl:hidden"
        aria-expanded="false"
        aria-controls="home-menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        Menu
      </button>
    </div>
    <nav id="home-menu" class="hidden border-t border-white/15 bg-forest-900 px-4 py-2 xl:hidden" aria-label="Menu">
      {menuNav.map((item) => (
        <a
          href={item.href}
          class="flex min-h-11 items-center text-base font-semibold text-white"
          data-guide-link={item.guideName ? 'true' : undefined}
          data-guide-name={item.guideName}
          data-placement={item.placement}
        >{item.label}</a>
      ))}
    </nav>
    <script is:inline>
      const homeMenuBtn = document.getElementById('home-menu-btn');
      const homeMenu = document.getElementById('home-menu');
      homeMenuBtn?.addEventListener('click', () => {
        homeMenu?.classList.toggle('hidden');
        homeMenuBtn.setAttribute('aria-expanded', String(!homeMenu?.classList.contains('hidden')));
      });
    </script>
  </header>

  <section class="bg-forest-700 text-white" aria-labelledby="home-heading">
    <div class="mx-auto max-w-7xl px-4 pb-2 pt-8 sm:px-6 xl:px-8 xl:pb-4 xl:pt-14">
      <h1 id="home-heading" class="max-w-[20rem] font-display text-[32px] font-black leading-[38px] [text-wrap:balance] xl:max-w-4xl xl:text-6xl xl:leading-tight">
        Find the right golf<br class="xl:hidden" /> gear, fast
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-white xl:text-lg">Honest buyer guides, sorted by what you're shopping for.</p>
    </div>
    <div class="bg-white text-forest-900 xl:bg-transparent">
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 xl:px-8 xl:pb-10 xl:pt-4">
        <h2 id="shop-for" class="mb-3 font-display text-2xl font-bold text-forest-900 xl:font-body xl:text-lg xl:font-semibold xl:leading-6 xl:text-white">What are you shopping for?</h2>
        <div class="grid grid-cols-2 gap-2 xl:flex xl:flex-wrap xl:gap-x-5 xl:gap-y-2" aria-labelledby="shop-for">
          {tiles.map((tile, index) => (
            <a
              href={tile.href}
              class:list={[tileClass, tile.slug === 'best-golf-gifts' && 'col-span-2']}
              data-guide-link="true"
              data-guide-name={tile.label}
              data-guide-slug={tile.slug}
              data-module="home_tiles"
              data-position={String(index + 1)}
              data-placement="home_tiles"
            >
              {tile.label}<span aria-hidden="true"> →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="xl:mx-auto xl:grid xl:max-w-7xl xl:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)] xl:items-start xl:gap-10 xl:px-8 xl:py-10">
    <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 xl:mx-0 xl:max-w-none xl:px-0 xl:py-0" aria-labelledby="most-used">
      <h2 id="most-used" class="font-display text-2xl font-bold text-forest-900">Golfers' most-used guides</h2>
      <div class="mt-2">
        {mostUsed.map((guide, index) => (
          <a
            href={guide.href}
            class={rowClass}
            data-guide-link="true"
            data-guide-name={guide.label}
            data-guide-slug={guide.slug}
            data-module="home_most_used"
            data-position={String(index + 1)}
            data-placement="home-buyer-card"
          >
            {guide.label}<span aria-hidden="true"> →</span>
          </a>
        ))}
      </div>
      <a
        href="/best/"
        class="mt-4 flex min-h-12 items-center justify-center rounded-md bg-forest-900 px-4 text-center text-base font-semibold text-white xl:mt-6 xl:inline-flex xl:bg-transparent xl:px-0 xl:text-forest-900"
        data-guide-link="true"
        data-guide-name="All Guides"
        data-module="home_all_guides"
        data-position="1"
        data-placement="home-buyer-card"
      >
        See all 50+ buyer guides<span class="hidden xl:inline" aria-hidden="true"> →</span>
      </a>
    </section>

    <div class="contents xl:block xl:rounded-xl xl:bg-[#F6F3E8] xl:p-8">
      <section class="bg-[#F6F3E8] px-4 py-6 sm:px-6 xl:bg-transparent xl:p-0" aria-labelledby="more-ways">
        <h2 id="more-ways" class="font-display text-2xl font-bold text-forest-900">More ways to shop</h2>
        <div class="mt-2 flex flex-col">
          {moreWays.map((item) => (
            <a
              href={item.href}
              class={moreClass}
              data-guide-link="true"
              data-guide-name={item.guideName}
              data-guide-slug={item.slug}
              data-module={item.module}
              data-position={String(item.position)}
              data-placement={item.placement}
            >
              {item.label}<span aria-hidden="true"> →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 xl:mx-0 xl:mt-8 xl:max-w-none xl:px-0 xl:py-0" aria-labelledby="latest-reviews">
        <h2 id="latest-reviews" class="font-display text-2xl font-bold text-forest-900">Latest reviews</h2>
        <div class="mt-2">
          {reviews.map((post, index) => (
            <a
              href={`/blog/${post.slug}/`}
              class="flex min-h-12 flex-col justify-center border-b border-[#12301C]/10 py-2"
              data-guide-link="true"
              data-guide-name={post.data.title}
              data-guide-slug={post.slug}
              data-module="home_reviews"
              data-position={String(index + 1)}
              data-placement="home_reviews"
            >
              <span class="text-base font-semibold leading-snug text-forest-900">{post.data.title}</span>
              <time class="text-sm text-gray-600" datetime={(post.data.updated || post.data.date).toISOString()}>{formatDate(post.data.updated || post.data.date)}</time>
            </a>
          ))}
        </div>
        <a href="/reviews/" class="mt-3 inline-flex min-h-11 items-center text-base font-semibold text-forest-900">All reviews <span aria-hidden="true">→</span></a>
      </section>
    </div>
  </div>

  <footer slot="footer" class="bg-forest-900 text-white">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <p class="text-sm leading-relaxed text-white/90">
        We test and write independently. Some links earn us a commission at no cost to you.
        <a href="/affiliate-disclosure/" class="inline-flex min-h-11 items-center font-semibold text-gold-500 underline underline-offset-2">Affiliate Disclosure</a>
      </p>
      <p class="mt-2 text-xs text-white/70">As an Amazon Associate and affiliate partner, we earn from qualifying purchases.</p>
      <nav class="mt-4 flex flex-wrap gap-x-3 gap-y-2 text-sm" aria-label="Footer">
        {footerLinks.map((item) => (
          <a href={item.href} class="inline-flex min-h-11 min-w-11 items-center px-1 text-white/90">{item.label}</a>
        ))}
      </nav>
    </div>
  </footer>
</BaseLayout>
