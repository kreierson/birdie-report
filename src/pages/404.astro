---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | The Birdie Report"
  description="That page is not on The Birdie Report."
  noindex
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl font-bold text-forest-900">Page not found</h1>
    <p class="mt-4 text-lg leading-relaxed text-gray-700">That URL is not on the site. These are good places to start:</p>
    <ul class="mt-6 space-y-2 text-lg">
      <li><a href="/" class="inline-flex min-h-11 items-center font-semibold text-forest-800 underline underline-offset-2">Home</a></li>
      <li><a href="/best/" class="inline-flex min-h-11 items-center font-semibold text-forest-800 underline underline-offset-2">Best Of</a></li>
      <li><a href="/reviews/" class="inline-flex min-h-11 items-center font-semibold text-forest-800 underline underline-offset-2">Reviews</a></li>
    </ul>
  </div>
</BaseLayout>
