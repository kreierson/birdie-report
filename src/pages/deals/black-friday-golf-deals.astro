---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlackFridayCta from '../../components/BlackFridayCta.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { sectionTrail } from '../../utils/breadcrumbs.mjs';
import {
  BF_HUB_PATH,
  BF_HUB_URL,
  bfBuyingTips,
  bfCategories,
  bfDates,
  blackFridayStructuredData,
} from '../../utils/black-friday.mjs';

const title = 'Black Friday Golf Deals 2026 | The Birdie Report';
const description = '2026 Black Friday and Cyber Monday golf deals by category. Gear Birdie Report already reviews, with links to the guides. Check today\'s price.';
const structuredData = blackFridayStructuredData({ title, description });
const breadcrumbs = sectionTrail('deals', {
  name: 'Black Friday Golf Deals 2026',
  href: BF_HUB_PATH,
});
const jsonLd = JSON.stringify(structuredData).replaceAll('<', '\\u003c');

function guideClickAttrs(href: string, name: string) {
  if (!href.startsWith('/blog/best-') && !href.startsWith('/tools/')) return {};
  return {
    'data-guide-link': 'true',
    'data-guide-name': name,
    'data-placement': 'bf-hub-guide',
  };
}

const published = new Date('2026-11-02T00:00:00Z');
const publishedLabel = published.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description} canonical={BF_HUB_URL} image="/images/hero-golf.jpg">
  <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  <article class="bg-white">
    <header class="border-b border-gray-200 bg-forest-950 text-white">
      <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
        <Breadcrumbs items={breadcrumbs} layout="inline" tone="dark" class="mb-4" />
        <p class="mb-3 text-xs font-bold uppercase tracking-wider text-gold-400">Black Friday and Cyber Monday 2026</p>
        <h1 class="font-display text-3xl font-black leading-tight sm:text-5xl">Black Friday Golf Deals 2026</h1>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-white/80 sm:text-lg">
          The category list for Black Friday on November 27 and Cyber Monday on November 30. Every pick is gear Birdie Report already reviews. The button checks today's price. This page gets updated when an offer is actually live.
        </p>
        <p class="mt-4 text-sm text-white/60">
          By <a class="underline underline-offset-2 hover:text-gold-300" href="/about/">Kyle Reierson</a>
          <span aria-hidden="true"> · </span>
          Published <time datetime="2026-11-02">{publishedLabel}</time>
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-10">
      <p class="text-base leading-relaxed text-gray-800">
        This URL stays the same each year. The year in the title is the season we are covering. Nothing below is a weekend price we checked, and nothing here is a historical low. There is no countdown. A "see options" button opens Amazon search. A "see this product" button opens one verified product page. Confirm the model, the seller, and today's price either way. We may earn a commission if you buy through those links. The longer version is the <a class="font-semibold text-forest-800 underline underline-offset-2" href="/affiliate-disclosure/">affiliate disclosure</a>.
      </p>
      <p class="mt-4 text-base leading-relaxed text-gray-800">
        Shopping by budget instead of by club? The <a class="font-semibold text-forest-800 underline underline-offset-2" href="/blog/best-golf-gifts/" {...guideClickAttrs('/blog/best-golf-gifts/', '2026 golf gift guide')}>2026 golf gift guide</a> sorts gear this site already covers from stocking stuffers through the splurge tier. The dated posts on the <a class="font-semibold text-forest-800 underline underline-offset-2" href="/deals/">deals archive</a> are old checks. When their date has passed, they are marked expired. This hub does not send you to them.
      </p>

      <nav aria-label="On this page" class="mt-8 rounded-lg border border-forest-100 bg-forest-50 p-4">
        <h2 class="text-sm font-bold uppercase tracking-wide text-forest-800">On this page</h2>
        <ol class="mt-3 grid gap-2 sm:grid-cols-2 text-sm">
          <li><a class="font-semibold text-forest-800 underline underline-offset-2" href="#dates">Key dates</a></li>
          <li><a class="font-semibold text-forest-800 underline underline-offset-2" href="#buying-tips">How to tell a real deal</a></li>
          {bfCategories.map((category) => (
            <li><a class="font-semibold text-forest-800 underline underline-offset-2" href={`#${category.id}`}>{category.title}</a></li>
          ))}
        </ol>
      </nav>

      <section class="mt-10" aria-labelledby="dates">
        <h2 id="dates" class="font-display text-2xl font-bold text-forest-900">Key dates</h2>
        <p class="mt-3 text-base leading-relaxed text-gray-800">
          Golf clubs do not spoil on December 1. If the model, the shaft, and the hand are wrong, a weekend price does not fix the bag. We will update the category sections below as Black Friday and Cyber Monday offers go live, and we will say so in the section we change.
        </p>
        <dl class="mt-4 divide-y divide-gray-200 rounded-lg border border-gray-200">
          {bfDates.map((entry) => (
            <div class="grid gap-1 px-4 py-3 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-4">
              <dt class="font-bold text-forest-900">
                <time datetime={entry.iso}>{entry.name}</time>
              </dt>
              <dd class="text-sm leading-relaxed text-gray-700">{entry.detail}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="mt-10" aria-labelledby="buying-tips">
        <h2 id="buying-tips" class="font-display text-2xl font-bold text-forest-900">How to tell a real deal</h2>
        <p class="mt-3 text-base leading-relaxed text-gray-800">
          A real deal is the club, ball, or shoe the guide already recommended, offered by a seller you can identify, in the variant you meant to buy. The rest is a different product with a friendlier number next to it.
        </p>
        <ol class="mt-4 space-y-4">
          {bfBuyingTips.map((tip, index) => (
            <li class="rounded-lg border border-gray-200 bg-gray-50 p-4">
              <h3 class="font-bold text-forest-900">{index + 1}. {tip.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-gray-700">{tip.text}</p>
            </li>
          ))}
        </ol>
      </section>

      {bfCategories.map((category) => (
        <section class="mt-12 border-t border-gray-200 pt-10" aria-labelledby={category.id}>
          <h2 id={category.id} class="font-display text-2xl font-bold text-forest-900">{category.title}</h2>
          <p class="mt-3 text-base leading-relaxed text-gray-800">{category.lede}</p>
          <p class="mt-3 text-sm leading-relaxed text-gray-700">
            {category.guides.map((guide, index) => (
              <>
                {index === 0 ? 'Start with the ' : index === category.guides.length - 1 ? ', and the ' : ', the '}
                <a class="font-semibold text-forest-800 underline underline-offset-2" href={guide.href} {...guideClickAttrs(guide.href, guide.label)}>{guide.label}</a>
              </>
            ))}
            .
          </p>
          <div class="mt-6 space-y-8">
            {category.picks.map((pick) => (
              <div>
                <h3 class="text-xl font-bold text-gray-950">{pick.product}</h3>
                <p class="mt-2 text-base leading-relaxed text-gray-800">{pick.note}</p>
                <p class="mt-2 text-sm leading-relaxed text-gray-700">
                  Read the <a class="font-semibold text-forest-800 underline underline-offset-2" href={pick.guideHref} {...guideClickAttrs(pick.guideHref, pick.guideLabel)}>{pick.guideLabel}</a>
                  {pick.also?.map((link, index) => (
                    <>
                      {index === pick.also.length - 1 ? ' and the ' : ', the '}
                      <a class="font-semibold text-forest-800 underline underline-offset-2" href={link.href} {...guideClickAttrs(link.href, link.label)}>{link.label}</a>
                    </>
                  ))}
                  .
                </p>
                <BlackFridayCta product={pick.product} url={pick.url} />
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="mt-12 rounded-lg border border-orange-200 bg-orange-50 p-5" aria-labelledby="updates">
        <h2 id="updates" class="font-display text-xl font-bold text-forest-900">This page will change when the sales do</h2>
        <p class="mt-2 text-sm leading-relaxed text-gray-800">
          Published {publishedLabel}, before Black Friday, so the hub is up while the sales are still ahead. When we check a live offer, we will add it to the category it belongs in and name the date we checked it. Until that sentence is here, the Amazon button is only a way to check today's price.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
