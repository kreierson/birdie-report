---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/CategoryPage.astro';
import CommercialOpportunityPanel from '../../components/CommercialOpportunityPanel.astro';
---

<BaseLayout 
  title="Golf Deals & Savings | The Birdie Report"
  description="Past golf deals and buying guides. Check the retailer for current pricing and availability."
>
  <CategoryPage
    category="deals"
    title="Deals & Savings"
    description="Browse our deal archive. Offers are dated and may have ended; confirm current prices with the retailer."
    accentColor="orange"
    badgeLabel="Deals"
    badgeClass="bg-orange-500 text-white"
  >
    <CommercialOpportunityPanel
      title="Check the fit before chasing the discount"
      description="A discount only helps if the gear suits your game. Use these guides to compare the features you actually need."
    />
  </CategoryPage>
</BaseLayout>
