---
import { getCollection } from 'astro:content';
import BlogArchive from '../../../components/BlogArchive.astro';
import { archivePages } from '../../../utils/archive.mjs';
export async function getStaticPaths() {
  return archivePages(await getCollection('blog')).slice(1).map(page => ({
    params: { page: String(page.current) }, props: page,
  }));
}
---
<BlogArchive {...Astro.props} />
